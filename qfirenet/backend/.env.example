# ─────────────────────────────────────────────────────────────────────────────
# QFireNet Backend — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your real values in the NEW .env file
#   3. Never commit the actual .env to version control (it's in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL Connection ─────────────────────────────────────────────────────
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
#
# Default local setup assumes:
#   - PostgreSQL running on localhost:5432
#   - A database named "qfirenet" (create with: CREATE DATABASE qfirenet;)
#   - User "postgres" with password "yourpassword"
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/qfirenet

# ── Groq API ──────────────────────────────────────────────────────────────────
# Get your free key from: https://console.groq.com → API Keys → Create Key
GROQ_API_KEY=your_groq_api_key_here

# ── Groq Model Selection ──────────────────────────────────────────────────────
# Available fast models on Groq (as of 2025):
#   llama-3.3-70b-versatile   ← recommended (best reasoning)
#   llama-3.1-8b-instant      ← faster, lower quality
#   mixtral-8x7b-32768        ← good for longer contexts
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=512

# ── JWT Authentication ────────────────────────────────────────────────────────
# Secret key for signing JWT tokens.
# Generate a secure one: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=QFireNet
APP_VERSION=1.0.0

# Set DEBUG=True during development to see detailed error tracebacks.
# Always False in production!
DEBUG=True
